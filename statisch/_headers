/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self'; font-src 'self'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'; upgrade-insecure-requests
  Strict-Transport-Security: max-age=31536000; includeSubDomains
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), interest-cohort=()
  X-Frame-Options: DENY
  Cross-Origin-Opener-Policy: same-origin

# The pages this site writes ship no JavaScript at all, so `default-src 'none'`
# already closes script execution and no script-src line is needed. Two pages
# are copied in instead of written here - the system map and the game - and
# each brings its own script; each has its own block below, scoped to its own
# path and to nowhere else.

/karte/*
  Content-Security-Policy: default-src 'none'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:*; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The system map is a byte-identical copy of _netzwerk/SYSTEM_KARTE.html from the
# public repository. It is self-contained but carries inline style and script,
# so the relaxation is scoped to this one path and nowhere else. Its optional
# health watch probes http://127.0.0.1:8200 and falls back to the offline view
# when nothing answers - which, on a public host, is always.

/dizzcube/play/*
  Content-Security-Policy: default-src 'none'; script-src 'sha256-8ZrnzY1bvQZPtS1XJaay591NKjBi7oG8P70xRgtbMRM='; style-src 'unsafe-inline'; img-src 'none'; font-src 'none'; connect-src 'none'; media-src 'none'; object-src 'none'; worker-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY

# The game DizzCube (09.10.2026): one self-contained HTML file, built outside
# this repository and copied in byte for byte. Its one inline script is allowed
# by its hash and by nothing else - a changed byte in that script needs a new
# hash here, or the game does not start. It carries inline style, so that is
# allowed too. It loads nothing, opens no connection (connect-src 'none') and
# stores nothing on the device. It is never framed: frame-ancestors 'none' and
# DENY stand here as on every other page.

# The one render-blocking file used to revalidate on every page view - a full
# round trip of blank screen per navigation on a phone. Five minutes of
# freshness keeps a deploy's HTML/CSS pairing honest while letting every
# in-visit navigation paint from cache; a day of stale-while-revalidate lets
# the browser refresh it in the background instead of in front of the reader.
/stil.css
  Cache-Control: public, max-age=300, stale-while-revalidate=86400

/schrift/*
  Cache-Control: public, max-age=31536000, immutable

/bilder/*
  Cache-Control: public, max-age=604800
