# Einheitliche Zeilenenden im gesamten Dizz-Netzwerk (H-13, 17.06.2026).
# Repo speichert LF; verhindert die "LF will be replaced by CRLF"-Warnung
# bei jedem Commit auf Windows. Binärdateien explizit ausgenommen.
* text=auto eol=lf

# Quellen/Doku = immer LF
*.py   text eol=lf
*.md   text eol=lf
*.txt  text eol=lf
*.css  text eol=lf
*.js   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.html text eol=lf
*.json text eol=lf
*.yml  text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.ps1  text eol=lf
*.cs   text eol=lf

# Windows-Batch braucht CRLF
*.bat  text eol=crlf
*.cmd  text eol=crlf

# Binär — nie normalisieren
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.webp binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.sqlite binary
*.db   binary
*.exe  binary
*.dll  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.otf  binary